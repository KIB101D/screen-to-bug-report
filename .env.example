# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite   # comma-separated, tried when the main model is overloaded; empty = none
# GEMINI_THINKING_LEVEL=          # MINIMAL | LOW | MEDIUM | HIGH (Gemini 3.x)
# GEMINI_VIDEO_FPS=1
# GEMINI_UPLOAD_MODE=files        # files | inline
# GEMINI_TEMPERATURE=

# Vercel Blob (added automatically when a Blob store is connected; `vercel env pull .env.local` locally)
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=public               # must match the store: public | private
# NEXT_PUBLIC_BLOB_ACCESS=public

# Local development without a Blob store: post the file straight to /api/analyze.
# Do not use on Vercel (4.5 MB request body limit).
# NEXT_PUBLIC_UPLOAD_MODE=direct
